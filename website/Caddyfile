# Serves the prerendered site. Jokku's proxy handles TLS, so this is plain
# HTTP on $PORT (8080 when run outside Jokku).
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Clean URLs: /docs/quickstart serves /docs/quickstart/index.html.
	try_files {path} {path}/index.html {path}.html
	file_server

	# Build assets have content hashes in their names, so they never change.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
